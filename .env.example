# ==============================================
# DEPLOYVTC — Panel Deploy Configuration Example
# Salin menjadi .env lalu isi nilai sebenarnya.
# JANGAN commit file .env atau credential asli.
# ==============================================

# ---- Wajib ----
# IP publik VPS (dipakai membangun WEBHOOK_URL bot yang di-deploy)
# Contoh: 103.15.44.21 atau domain.com
VPS_IP=GANTI_DENGAN_IP_VPS

# Bot token untuk ADMIN deploy (bukan bot toko buyer)
# Dapat dari @BotFather, format: 123456789:AAF...
DEPLOY_BOT_TOKEN=GANTI_DENGAN_BOT_TOKEN

# Telegram ID admin deploy (bisa lebih dari satu, pisah koma)
# Dapat dari @userinfobot
ADMIN_ID=GANTI_DENGAN_TELEGRAM_ID

# Port panel deploy
PORT=3080

# ---- Opsional ----
# Maksimum container bot yang bisa jalan
MAX_CONTAINERS=8

# Template image untuk container bot (dibangun dari repo vitaicmin)
BOT_TEMPLATE_IMAGE=store-bot

# Direktori data buyer (db, assets, logs tiap bot)
DATA_DIR=/root/data

# ---- Perpanjangan license (Renew) ----
# Harga per bulan (Rp) untuk perpanjangan. Default 30000.
# Harga per hari dihitung = harga/bulan / 30.
RENEW_PRICE_PER_MONTH=30000

# Kredensial KlikQRIS untuk pembayaran perpanjangan via Snap modal.
# Bisa sama dengan kredensial bot atau khusus merchant panel.
KLIKQRIS_API_KEY=GANTI_DENGAN_API_KEY
KLIKQRIS_MERCHANT_ID=GANTI_DENGAN_MERCHANT_ID

# ---- Backup (opsional, via rclone) ----
RCLONE_REMOTE=gdrive
BACKUP_HOUR=3

# ---- Admin Web Panel (/admin) ----
# WAJIB di-set supaya admin panel aktif. Tanpa ini, /admin menampilkan
# "Admin Panel Nonaktif" (fail-closed) — aman secara default.
#
# Password untuk login ke admin panel (ganti dengan password kuat!)
ADMIN_PANEL_PASSWORD=GANTI_DENGAN_PASSWORD_ADMIN

# Secret untuk menandatangani JWT sesi admin (harus string acak panjang!)
# Generate: openssl rand -hex 32  → tempel hasilnya di sini
ADMIN_JWT_SECRET=GANTI_DENGAN_HASIL_OPENSSL_RAND_HEX_32
